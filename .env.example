# Opcional: aumenta o limite de requisições do GitHub (somente servidor).
GITHUB_TOKEN=
# Obrigatórias para enviar e-mails. Use um remetente de domínio verificado no Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# URL pública canônica, por exemplo https://seu-dominio.com
SITE_URL=

# Alternativa à configuração Resend acima: mantém o envio SMTP existente.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
